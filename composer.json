{
  "name": "converter-studio/grav-plugin-converter-studio",
  "type": "grav-plugin",
  "description": "Converts uploads that browsers and Grav cannot use into JPG, WebP, MP4, PDF or MP3 with the Converter Studio API.",
  "keywords": [
    "grav",
    "plugin",
    "heic",
    "convert",
    "video",
    "pdf"
  ],
  "homepage": "https://converter.studio",
  "license": "MIT",
  "authors": [
    {
      "name": "Converter Studio",
      "email": "support@converter.studio",
      "homepage": "https://converter.studio"
    }
  ],
  "support": {
    "issues": "https://github.com/tariksucu/grav-plugin-converter-studio/issues",
    "source": "https://github.com/tariksucu/grav-plugin-converter-studio"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "symfony/http-client": "^6.4 || ^7.0",
    "symfony/yaml": "^6.4 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "Grav\\Plugin\\ConverterStudio\\": "classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Grav\\Plugin\\ConverterStudio\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
